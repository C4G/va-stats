# Copy to .env and fill in real values. Do NOT commit .env.

# --- External MySQL database ---
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_DATABASE=your-database
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password

# --- Auth (Better Auth: Google, email/password, and passkeys) ---
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-a-random-secret-with-at-least-32-characters
# WebAuthn relying-party hostname only (no scheme or port). Use localhost in dev.
BETTER_AUTH_RP_ID=localhost
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Resend is required for email verification and password resets. The sender's
# domain must be verified in Resend before it can deliver to staff addresses.
RESEND_API_KEY=re_your-api-key
RESEND_FROM_EMAIL=Vision-Aid STATS <auth@example.com>

# --- Public config (inlined into the bundle at build time) ---
# Base origin of the deployed app, used to build absolute API URLs
# server-side. No trailing slash and no /api suffix (the code appends the path).
NEXT_PUBLIC_BASE_URL=http://localhost:3000
